---
// Compare screen — pick 2–4 neighbourhoods, see them side by side over 10 years
// against the Toronto baseline. The data is fetched at hydration so we
// don't ship a 158-entry aggregate into every page bundle.
//
// Ported from styleguide/screens/compare.jsx.

import Site from '../layouts/Site.astro';
import CompareScreen from '../components/islands/CompareScreen.tsx';
import PrimaryCatText from '../components/islands/PrimaryCatText.tsx';
import CopyViewButton from '../components/preact/CopyViewButton.tsx';
import { allNeighbourhoods } from '../lib/aggregates';
import { DEFAULT_COMPARE_PICKS } from '../lib/urlState';

// Resolve the default comparison at build time so crawlers and no-JS readers
// get real, linked content (the interactive comparison itself is client:only).
const byId = new Map(allNeighbourhoods().map((n) => [n.id, n]));
const defaultPicks = DEFAULT_COMPARE_PICKS.map((id) => byId.get(id)).filter(
  (n): n is NonNullable<typeof n> => Boolean(n),
);
---
{/* No view rail here: the compare screen reads only primaryCat + unit —
    its own category chips and the topbar unit toggle cover both. */}
<Site
  title="Toronto Crime Pulse · Compare"
  description="Compare 2–4 Toronto neighbourhoods side by side over ten years against the city-wide baseline, by crime category, as counts or rate per 10,000 residents."
  active="compare"
>
  <div class="page" data-screen-label="03 Compare">
    <section>
      <div class="main" style="padding: 48px 0 24px;">
        <div class="eyebrow" style="margin-bottom: 12px;">§ Compare · 2–4 neighbourhoods · 10 years</div>
        <h1 style="font-family: var(--font-sans); font-weight: 600; font-size: 48px; letter-spacing: -0.02em; margin: 0;">
          Side by side, same y-axis.
        </h1>
        <p style="font-size: 16px; color: var(--ink-2); max-width: 60ch; margin-top: 16px;">
          Pick two to four neighbourhoods. Compare their <PrimaryCatText client:load template="$L" /> trends. Add the Toronto-wide baseline with the chart toggle; it starts hidden for counts and shown for rates.
        </p>
        <CopyViewButton client:load />
      </div>
    </section>

    <noscript>
      <section class="section">
        <div class="main">
          <p style="font-size: 15px; color: var(--ink-2); max-width: 60ch;">
            The side-by-side comparison needs JavaScript. By default it compares{' '}
            {defaultPicks.map((n, i) => (
              <>
                {i > 0 ? (i === defaultPicks.length - 1 ? ', and ' : ', ') : ''}
                <a href={`/neighbourhood/${n.id}/`} style="color: var(--accent);">{n.name}</a>
              </>
            ))}{' '}
            against the Toronto-wide baseline. You can open each neighbourhood
            directly, or <a href="/neighbourhood/" style="color: var(--accent);">browse all 158</a>.
          </p>
        </div>
      </section>
    </noscript>

    <CompareScreen client:only="preact" />
  </div>
</Site>
