---
// CSICard — Toronto-vs-other-cities Crime Severity Index bars.
//
// Reads `csi-context.json` (emitted by scripts/build_aggregates.py from
// data/csi/csi-by-geography.md, which scripts/import_csi.py pulls from
// StatCan table 35-10-0026-01). If the aggregate isn't present yet the
// card renders nothing — the Overview falls back without it.
//
// All values are real. The styleguide-era CSICard used fabricated numbers
// and was removed 2026-05-27; this is the restored version against the
// real annual series.

import { csiContext } from '../lib/aggregates';

const ctx = csiContext();
const latestYear = ctx ? ctx.years[ctx.years.length - 1] : null;

interface BarRow {
  label: string;
  value: number;
  accent: boolean;
}

const rows: BarRow[] = ctx && latestYear != null
  ? ctx.geographies
      .map((g) => {
        const pt = g.series.find((p) => p.year === latestYear);
        const v = pt?.csi_total;
        return v != null ? { label: g.label, value: v, accent: !!g.accent } : null;
      })
      .filter((r): r is BarRow => r !== null)
      .sort((a, b) => a.value - b.value)
  : [];

const max = rows.length ? Math.max(...rows.map((r) => r.value)) * 1.05 : 1;
---
{ctx && rows.length > 0 && (
  <div class="csi-card">
    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px;">
      <h3 class="card-title">Toronto in national context</h3>
      <span class="card-sub">CSI · {latestYear}</span>
    </div>
    <div style="font-size: 13px; color: var(--ink-2); max-width: 42ch;">
      Statistics Canada's <strong style="color: var(--ink);">Crime Severity Index</strong> weights offences by seriousness. Lower is less severe overall crime. Toronto's value is the Toronto-CMA aggregate from {ctx.source.name}.
    </div>
    <div class="csi-bars">
      {rows.map((r) => (
        <div class="csi-bar-row">
          <span class="csi-bar-label" style={r.accent ? 'color: var(--accent);' : ''}>{r.label}</span>
          <div class="csi-bar-track">
            <div
              class="csi-bar-fill"
              style={`width: ${(r.value / max) * 100}%; background: ${r.accent ? 'var(--accent)' : 'var(--ink-3)'};`}
            />
          </div>
          <span class="csi-bar-val" style={`color: ${r.accent ? 'var(--accent)' : 'var(--ink-2)'};`}>{r.value.toFixed(1)}</span>
        </div>
      ))}
    </div>
    <div style="margin-top: 12px; font-family: var(--font-mono); font-size: 10px; color: var(--ink-4); letter-spacing: 0.04em;">
      Source: StatCan table 35-10-0026-01 · CSI {latestYear}
    </div>
  </div>
)}
