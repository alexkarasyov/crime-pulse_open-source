---
// BrandMark — standalone "Live Signal" equalizer mark at an arbitrary size.
// Static (no idle animation); used as a decorative brand accent in the hero
// and footer. Bars inherit --ink (via currentColor); the peak bar is --accent.
interface Props {
  size?: number;
}
const { size = 40 } = Astro.props;
---
<svg
  viewBox="0 0 40 40"
  width={size}
  height={size}
  role="img"
  aria-label="Crime Pulse"
  style="color: var(--ink); display: block;"
>
  <rect x="1.5"  y="20"    width="5" height="14"    rx="1" fill="currentColor" />
  <rect x="9.5"  y="13.84" width="5" height="20.16" rx="1" fill="currentColor" />
  <rect x="17.5" y="18.32" width="5" height="15.68" rx="1" fill="currentColor" />
  <rect x="25.5" y="6"     width="5" height="28"    rx="1" style="fill: var(--accent)" />
  <rect x="33.5" y="15.52" width="5" height="18.48" rx="1" fill="currentColor" />
</svg>
